{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miami Organizer",
  "version": "0.1.0",
  "identifier": "app.miami.organizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Miami Organizer", "width": 390, "height": 844, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "iOS": { "developmentTeam": "" }
  }
}
